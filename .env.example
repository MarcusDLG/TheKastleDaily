# Copy to .env for compose runs. Everything is optional until delivery and
# drafting are enabled; empty values disable those stages.
KASTLE_DB=/data/kastle.db

# Secret backend: `env` (default) reads the values below from this file.
# `aws` resolves them from AWS Secrets Manager instead — secrets named
# `SECRETS_PREFIX + <NAME>` (e.g. kastle-daily/OPENAI_API_KEY), fetched
# once per process; env values still win when both are set.
SECRETS_BACKEND=env
SECRETS_PREFIX=kastle-daily/
# AWS backend only: credentials boto3 uses to reach Secrets Manager.
# Skip on EC2/Fargate (instance/task role) — needed on Lightsail et al.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Send to Kindle delivery (SMTP). Use an app-specific password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# One address, or a comma-separated list — every address gets each edition.
KINDLE_ADDRESS=

# Editorial drafting model. Empty key uses the local template generator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Reasoning budget for gpt-5-family models (minimal/low/medium/high).
OPENAI_REASONING_EFFORT=low
# Per-edition estimated cost cap in USD; drafting declines past this.
OPENAI_MAX_COST_USD=0.50
# Optional pricing overrides per million tokens for unlisted models.
OPENAI_INPUT_COST_PER_MTOK=
OPENAI_OUTPUT_COST_PER_MTOK=

# Operations dashboard (admin compose profile). A password enables
# Basic auth + feed management writes; empty keeps the page read-only.
ADMIN_USERNAME=
ADMIN_PASSWORD=
